{
  "name": "frontmind-brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "pnpm --dir module typecheck && tsc --noEmit -p tsconfig.json",
    "build:business": "pnpm -r --filter \"./vendor/**\" --if-present build && pnpm --dir module build",
    "test": "pnpm build:business && pnpm --dir module --if-present test",
    "build": "pnpm build:business && vite build",
    "build:preview": "vite build --mode preview --outDir dist/preview"
  },
  "dependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "framer-motion@12.23.22>motion-dom": "12.23.21",
      "framer-motion@12.23.22>motion-utils": "12.23.6",
      "motion-dom@12.23.21>motion-utils": "12.23.6"
    }
  }
}
