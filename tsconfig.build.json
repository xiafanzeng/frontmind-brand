{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "module",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "module/contracts/**/*.ts",
    "module/server/**/*.ts"
  ],
  "exclude": []
}
